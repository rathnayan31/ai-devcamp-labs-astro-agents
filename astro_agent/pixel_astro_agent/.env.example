# Copy to pixel_astro_agent/.env (adk web loads it automatically).

# --- Gemini via Vertex AI (uses `gcloud auth application-default login`) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=ai-devcamp-lab
GOOGLE_CLOUD_LOCATION=global
# Or use an AI Studio key instead of Vertex:
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=

ROOT_MODEL=gemini-3.8-flash
SPECIALIST_MODEL=gemini-3.8-flash

# --- Pixel Astro Node API (must run with AGENT_MCP_ENABLED=true) ---
PIXEL_ASTRO_MCP_URL=http://localhost:3000/api/v1/agent-mcp
# Local direct-to-MCP testing only: use a short-lived, MCP-scoped token minted
# by the Pixel Astro server. Never put a user's app JWT here.
PIXEL_ASTRO_AGENT_MCP_TOKEN=
